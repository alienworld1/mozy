# Public endpoints. A provider-specific Sepolia URL is recommended for reliability.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
FOREIGN_RPC_URL=
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Use one newly generated disposable testnet-only account on both chains.
# Never use an account that has held real assets.
ATTESTCOIN_DISPOSABLE_PRIVATE_KEY=

# Deploy ReceiptSemanticProbe to CC3 Testnet, then record its address here.
ATTESTCOIN_PROBE_ADDRESS=
