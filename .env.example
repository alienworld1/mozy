# Public endpoints. A provider-specific Sepolia URL is recommended for reliability.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
FOREIGN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Browser-safe RPC endpoints used by the Mozy web app. Both are required.
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_FOREIGN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Use one newly generated disposable testnet-only account on both chains.
# Never use an account that has held real assets.
ATTESTCOIN_DISPOSABLE_PRIVATE_KEY=

# Deploy ReceiptSemanticProbe to CC3 Testnet, then record its address here.
ATTESTCOIN_PROBE_ADDRESS=

# Protocol release deployment. Use the same disposable CC3 account for deployer
# and initial protocol admin so the deterministic script can complete one-time wiring.
MOZY_DEPLOYER_PRIVATE_KEY=
MOZY_PROTOCOL_ADMIN=
